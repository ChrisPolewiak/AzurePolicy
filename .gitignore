.venv/
__pycache__/

# Temporary Office files
docs/~$*.*

# Central deployment configuration — contains environment-specific IDs and paths
# configuration/*
# !configuration/README.md
# !configuration/deployment-config.example.json

# ADO environment variables — contains org/project-specific pool and service connection names
configuration/ado-env.yml

# Sync-framework pipeline — contains hardcoded GitHub service connection name (cannot use variables in resources:)
pipelines/sync-framework.yml

# Environment-specific pipelines — set up from .example.yml templates during deployment
pipelines/fetch-policies.yml
pipelines/rebuild-configuration.yml
pipelines/update-definitions.yml
pipelines/update-assignments.yml
pipelines/cleanup.yml

# Policy snapshot fetched from GitHub (Pipeline A artifact)
source/EnterpriseALZ/*

# Generated ARM JSON templates (Pipeline B artifact)
bicep/policyDefinitions/
bicep/policySetDefinitions/
generated/*.json

# Internal development notes — not for release
PROGRESS.md